<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="management-host-root" class="management-host-root">
        <ui:VisualElement name="management-host-header" class="management-host-header">
            <ui:Label name="management-host-title" text="管理" class="management-host-title" />
            <ui:Button name="management-host-close" text="关闭" class="management-host-close" style="display: none;" />
        </ui:VisualElement>
        <ui:VisualElement name="management-host-nav" class="management-host-nav">
            <ui:Button name="management-host-nav-overview" text="概览" class="management-host-nav-button" />
            <ui:Button name="management-host-nav-turn-summary" text="回合" class="management-host-nav-button" />
            <ui:Button name="management-host-nav-ledger" text="账本" class="management-host-nav-button" />
            <ui:Button name="management-host-nav-tech" text="科技" class="management-host-nav-button" />
            <ui:Button name="management-host-nav-build" text="建造" class="management-host-nav-button" />
            <ui:Button name="management-host-nav-recipe" text="配方" class="management-host-nav-button" />
            <ui:Button name="management-host-nav-policy" text="国策" class="management-host-nav-button" />
            <ui:Button name="management-host-nav-institution" text="制度" class="management-host-nav-button" />
        </ui:VisualElement>
        <ui:VisualElement name="management-host-overview-panel" class="national-overview-panel" style="display: none;">
            <ui:VisualElement class="national-overview-summary-grid">
                <ui:VisualElement class="national-overview-summary-row">
                    <ui:Label name="national-overview-turn-value-label" text="回合" class="national-overview-label" />
                    <ui:Label name="national-overview-turn-value" text="--" class="national-overview-value" />
                </ui:VisualElement>
                <ui:VisualElement class="national-overview-summary-row">
                    <ui:Label name="national-overview-phase-value-label" text="阶段" class="national-overview-label" />
                    <ui:Label name="national-overview-phase-value" text="--" class="national-overview-value" />
                </ui:VisualElement>
                <ui:VisualElement class="national-overview-summary-row">
                    <ui:Label name="national-overview-tokens-value-label" text="令牌" class="national-overview-label" />
                    <ui:Label name="national-overview-tokens-value" text="--" class="national-overview-value" />
                </ui:VisualElement>
                <ui:VisualElement class="national-overview-summary-row">
                    <ui:Label name="national-overview-research-value-label" text="研究" class="national-overview-label" />
                    <ui:Label name="national-overview-research-value" text="无" class="national-overview-value" />
                </ui:VisualElement>
                <ui:VisualElement class="national-overview-summary-row">
                    <ui:Label name="national-overview-policy-value-label" text="国策" class="national-overview-label" />
                    <ui:Label name="national-overview-policy-value" text="无" class="national-overview-value" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Label name="national-overview-metrics-title" text="指标" class="national-overview-section-title" />
            <ui:VisualElement name="national-overview-metrics" class="national-overview-list" />
            <ui:Label name="national-overview-resources-title" text="资源" class="national-overview-section-title" />
            <ui:VisualElement name="national-overview-resources" class="national-overview-list" />
            <ui:Label name="national-overview-events-title" text="近期事件" class="national-overview-section-title" />
            <ui:Label name="national-overview-empty-events" text="暂无近期事件" class="national-overview-empty" />
            <ui:VisualElement name="national-overview-events" class="national-overview-events" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
