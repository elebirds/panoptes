.management-panel-root {
    position: absolute;
    left: 5%;
    right: 5%;
    top: 5%;
    bottom: 5%;
    padding: 24px 28px;
    background-color: rgba(10, 7, 6, 0.97);
    color: rgb(250, 230, 184);
}

.management-panel-title {
    width: 100%;
    color: rgb(237, 239, 232);
    font-size: 28px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 20px;
}

.management-panel-empty {
    color: rgb(188, 194, 202);
    font-size: 16px;
    margin-bottom: 10px;
}

.management-panel-scroll,
.management-panel-policy-scroll {
    flex-grow: 1;
    min-height: 0;
}

.management-panel-groups,
.management-panel-policy-track {
    flex-direction: row;
    align-items: stretch;
    min-height: 720px;
    padding-bottom: 24px;
    padding-right: 56px;
}

.policy-focus-row {
    width: 360px;
    min-height: 700px;
    height: 100%;
    flex-shrink: 0;
    flex-direction: column;
    margin-right: 22px;
    padding: 22px 22px 24px 22px;
    background-color: rgba(26, 18, 14, 0.96);
    border-width: 1px;
    border-color: rgba(92, 61, 36, 0.95);
}

.policy-focus-row-image {
    width: 310px;
    height: 220px;
    align-self: center;
    margin-right: 0;
    margin-bottom: 20px;
}

.policy-focus-row-title {
    font-size: 26px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 18px;
}

.policy-focus-row-effect {
    color: rgb(255, 212, 107);
    font-size: 20px;
    -unity-font-style: bold;
    white-space: normal;
    margin-bottom: 18px;
}

.policy-focus-row-detail {
    color: rgb(224, 232, 240);
    font-size: 18px;
    white-space: normal;
}
