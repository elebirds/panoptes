.recipe-synthesis-root {
    position: absolute;
    left: 396px;
    top: 88px;
    width: 430px;
    max-height: 620px;
    padding: 12px;
    background-color: rgba(18, 21, 25, 0.92);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(181, 190, 184, 0.34);
    border-right-color: rgba(181, 190, 184, 0.34);
    border-top-color: rgba(181, 190, 184, 0.34);
    border-bottom-color: rgba(181, 190, 184, 0.34);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
}

.management-panel-title {
    color: rgb(237, 239, 232);
    font-size: 16px;
    -unity-font-style: bold;
    margin-bottom: 8px;
}

.management-panel-empty {
    color: rgb(146, 157, 158);
    font-size: 12px;
    padding-top: 8px;
    padding-bottom: 8px;
}

.management-panel-scroll {
    max-height: 560px;
}

.management-panel-groups {
    padding-right: 4px;
}

.management-panel-group {
    margin-top: 8px;
    padding-top: 6px;
    border-top-width: 1px;
    border-top-color: rgba(181, 190, 184, 0.22);
}

.management-panel-group-title {
    color: rgb(209, 217, 213);
    font-size: 12px;
    -unity-font-style: bold;
    margin-bottom: 5px;
}

.management-panel-row {
    min-height: 58px;
    margin-bottom: 6px;
    padding: 8px;
    background-color: rgba(38, 44, 50, 0.84);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(156, 168, 164, 0.18);
    border-right-color: rgba(156, 168, 164, 0.18);
    border-top-color: rgba(156, 168, 164, 0.18);
    border-bottom-color: rgba(156, 168, 164, 0.18);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
    align-items: stretch;
}

.management-panel-row-title {
    color: rgb(240, 242, 235);
    font-size: 13px;
    -unity-font-style: bold;
}

.management-panel-row-summary,
.management-panel-row-detail {
    color: rgb(167, 178, 178);
    font-size: 11px;
    white-space: normal;
    margin-top: 2px;
}

.management-panel-row-status {
    color: rgb(222, 214, 157);
    font-size: 11px;
    margin-top: 4px;
}

.management-panel-row-action {
    color: rgb(144, 194, 214);
    font-size: 11px;
    -unity-font-style: bold;
    margin-top: 4px;
}
