<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="management-panel-root" class="management-panel-root recipe-synthesis-root">
        <ui:Label name="management-panel-title" text="Recipe Synthesis" class="management-panel-title" />
        <ui:Label name="management-panel-empty" text="No recipes available" class="management-panel-empty" />
        <ui:ScrollView name="recipe-synthesis-scroll" class="management-panel-scroll">
            <ui:VisualElement name="management-panel-groups" class="management-panel-groups" />
        </ui:ScrollView>
    </ui:VisualElement>
</ui:UXML>
