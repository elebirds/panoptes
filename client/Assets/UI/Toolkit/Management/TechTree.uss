.management-panel-root {
    position: absolute;
    left: 396px;
    top: 88px;
    width: 430px;
    max-height: 620px;
    padding: 12px;
    background-color: rgba(18, 22, 27, 0.94);
    color: rgb(236, 240, 243);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(181, 190, 184, 0.34);
    border-right-color: rgba(181, 190, 184, 0.34);
    border-top-color: rgba(181, 190, 184, 0.34);
    border-bottom-color: rgba(181, 190, 184, 0.34);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
}

.management-panel-title {
    color: rgb(237, 239, 232);
    font-size: 30px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 18px;
}

.management-panel-empty {
    color: rgb(166, 174, 183);
    font-size: 12px;
    margin-bottom: 10px;
}

.management-panel-scroll {
    max-height: 560px;
}

.management-panel-tech-scroll {
    flex-grow: 1;
    min-height: 0;
}

.management-panel-group {
    margin-bottom: 12px;
}

.management-panel-group-title {
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(130, 190, 178);
    margin-bottom: 6px;
}

.management-panel-row {
    margin-bottom: 6px;
    padding: 10px;
    border-radius: 6px;
    background-color: rgba(255, 255, 255, 0.06);
    border-left-width: 3px;
    border-left-color: rgb(130, 190, 178);
}

.management-panel-row-title {
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(236, 240, 243);
}

.management-panel-row-summary,
.management-panel-row-detail,
.management-panel-row-status,
.management-panel-row-action {
    font-size: 13px;
    white-space: normal;
    color: rgb(190, 199, 207);
}

.management-panel-row-detail {
    color: rgb(190, 199, 207);
}

.management-panel-row-status {
    color: rgb(232, 199, 111);
}

.management-panel-row-action {
    color: rgb(130, 190, 178);
}
