.minister-report-root {
    flex-grow: 1;
    color: rgb(242, 231, 208);
    background-color: rgba(15, 19, 24, 0.94);
    border-radius: 7px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(238, 185, 103, 0.52);
    border-right-color: rgba(238, 185, 103, 0.35);
    border-bottom-color: rgba(238, 185, 103, 0.25);
    border-left-color: rgba(238, 185, 103, 0.35);
}

.minister-report-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    height: 48px;
    margin-bottom: 12px;
    padding-left: 14px;
    padding-right: 8px;
    border-radius: 5px;
    background-color: rgba(27, 31, 36, 0.82);
    border-bottom-width: 1px;
    border-bottom-color: rgba(238, 185, 103, 0.35);
}

.minister-report-title {
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(248, 226, 176);
}

.minister-report-close {
    width: 34px;
    height: 30px;
    padding: 0;
    border-radius: 4px;
    background-color: rgba(118, 82, 43, 0.76);
    color: rgb(255, 239, 205);
    -unity-font-style: bold;
}

.minister-report-body {
    flex-grow: 1;
    min-height: 0;
    flex-direction: row;
}

.minister-report-tabs {
    width: 210px;
    flex-shrink: 0;
    padding-top: 4px;
    padding-right: 14px;
    border-right-width: 1px;
    border-right-color: rgba(211, 158, 83, 0.45);
}

.minister-report-tab {
    min-height: 74px;
    margin-bottom: 10px;
    padding: 8px;
    flex-direction: row;
    align-items: center;
    border-radius: 6px;
    background-color: rgba(255, 255, 255, 0.055);
    border-left-width: 3px;
    border-left-color: rgba(211, 158, 83, 0.25);
}

.minister-report-tab.is-selected {
    background-color: rgba(211, 158, 83, 0.19);
    border-left-color: rgb(231, 178, 92);
}

.minister-report-tab-avatar {
    width: 52px;
    height: 52px;
    margin-right: 8px;
}

.minister-report-tab-text {
    flex-grow: 1;
    min-width: 0;
}

.minister-report-tab-name {
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(247, 232, 203);
    white-space: normal;
}

.minister-report-tab-title {
    font-size: 12px;
    color: rgb(181, 196, 204);
}

.minister-report-affection {
    width: 48px;
    height: 52px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    position: relative;
}

.minister-report-affection-heart {
    width: 24px;
    height: 24px;
    -unity-background-scale-mode: scale-to-fit;
}

.minister-report-affection-heart.is-pulsing {
    opacity: 1;
}

.minister-report-affection-value {
    position: absolute;
    left: 0;
    right: 0;
    top: 18px;
    -unity-text-align: middle-center;
    font-size: 11px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(132, 24, 78, 0.95);
}

.minister-report-affection-delta {
    position: absolute;
    left: -8px;
    right: -8px;
    top: -10px;
    -unity-text-align: middle-center;
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(255, 196, 226);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(82, 15, 48, 0.95);
}

.minister-report-conversation {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
    padding-left: 18px;
    padding-top: 10px;
    padding-right: 12px;
    border-radius: 6px;
    background-color: rgba(8, 12, 15, 0.36);
}

.minister-report-empty {
    color: rgb(160, 170, 176);
    margin-bottom: 8px;
}

.minister-report-scroll {
    flex-grow: 1;
    min-height: 0;
    margin-bottom: 12px;
    padding-right: 4px;
}

.minister-report-chat {
    flex-grow: 1;
    min-height: 0;
}

.minister-report-message {
    flex-direction: row;
    margin-bottom: 14px;
}

.minister-report-message.is-player {
    justify-content: flex-end;
}

.minister-report-message-avatar {
    width: 42px;
    height: 42px;
    margin-right: 10px;
    flex-shrink: 0;
}

.minister-report-avatar {
    align-items: center;
    justify-content: center;
    border-radius: 21px;
    background-color: rgb(88, 92, 102);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(248, 222, 162, 0.72);
    border-right-color: rgba(248, 222, 162, 0.72);
    border-bottom-color: rgba(248, 222, 162, 0.72);
    border-left-color: rgba(248, 222, 162, 0.72);
}

.minister-report-avatar-text {
    color: rgb(255, 238, 204);
    -unity-font-style: bold;
    font-size: 15px;
}

.minister-report-message-body {
    max-width: 72%;
}

.minister-report-message.is-player .minister-report-message-body {
    align-items: flex-end;
}

.minister-report-message-header {
    flex-direction: row;
    align-items: baseline;
    margin-bottom: 4px;
}

.minister-report-message-name {
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(247, 232, 203);
    margin-right: 8px;
}

.minister-report-message-title {
    font-size: 12px;
    color: rgb(174, 190, 199);
}

.minister-report-bubble-row {
    flex-direction: row;
    align-items: flex-start;
}

.minister-report-message.is-player .minister-report-bubble-row {
    justify-content: flex-end;
}

.minister-report-bubble-tail {
    width: 9px;
    height: 12px;
    margin-top: 12px;
    flex-shrink: 0;
}

.minister-report-bubble-tail.is-left {
    background-color: rgba(255, 255, 255, 0.08);
    border-left-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(211, 158, 83, 0.22);
    border-bottom-color: rgba(211, 158, 83, 0.22);
}

.minister-report-bubble-tail.is-right {
    background-color: rgba(61, 104, 135, 0.86);
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-right-color: rgba(151, 191, 215, 0.36);
    border-bottom-color: rgba(151, 191, 215, 0.36);
}

.minister-report-message-bubble {
    padding: 10px 12px;
    border-radius: 6px;
    white-space: normal;
    font-size: 14px;
    line-height: 19px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
}

.minister-report-message.is-minister .minister-report-message-bubble {
    background-color: rgba(255, 255, 255, 0.08);
    color: rgb(236, 240, 243);
    border-left-width: 3px;
    border-left-color: rgb(211, 158, 83);
    border-top-color: rgba(211, 158, 83, 0.22);
    border-right-color: rgba(211, 158, 83, 0.16);
    border-bottom-color: rgba(211, 158, 83, 0.16);
}

.minister-report-message.is-player .minister-report-message-bubble {
    background-color: rgba(61, 104, 135, 0.86);
    color: rgb(245, 249, 251);
    border-top-color: rgba(151, 191, 215, 0.36);
    border-right-color: rgba(151, 191, 215, 0.42);
    border-bottom-color: rgba(151, 191, 215, 0.28);
    border-left-color: rgba(151, 191, 215, 0.28);
}

.minister-report-options {
    min-height: 48px;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    padding-top: 10px;
    border-top-width: 1px;
    border-top-color: rgba(211, 158, 83, 0.35);
}

.minister-report-option {
    min-height: 34px;
    margin-right: 8px;
    margin-bottom: 6px;
    padding: 6px 12px;
    border-radius: 5px;
    color: rgb(255, 240, 214);
    background-color: rgba(83, 91, 101, 0.86);
}

.minister-report-option.is-accept {
    background-color: rgba(95, 122, 74, 0.9);
}

.minister-report-option.is-reject {
    background-color: rgba(116, 74, 70, 0.86);
}

.minister-report-option-empty {
    color: rgb(148, 158, 164);
    font-size: 13px;
}
