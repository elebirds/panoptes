{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://panoptes.local/schemas/armyconfig.schema.json",
  "title": "Panoptes Army Config",
  "type": "object",
  "required": ["config_version", "default_locale", "units"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "config_version": { "type": "string", "minLength": 1 },
    "default_locale": { "type": "string", "minLength": 1 },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/unit" }
    }
  },
  "$defs": {
    "resourceMap": {
      "type": "object",
      "additionalProperties": {
        "type": "integer"
      }
    },
    "multiplierMap": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0
      }
    },
    "flags": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "can_siege": { "type": "boolean" },
        "siege_multiplier": { "type": "number", "minimum": 0 },
        "can_destroy_road": { "type": "boolean" },
        "destroy_multiplier": { "type": "number", "minimum": 0 },
        "can_capture": { "type": "boolean" }
      }
    },
    "ui": {
      "type": "object",
      "required": ["sort_order"],
      "additionalProperties": false,
      "properties": {
        "sort_order": { "type": "integer", "minimum": 0 }
      }
    },
    "unit": {
      "type": "object",
      "required": [
        "id",
        "name",
        "description",
        "icon_key",
        "prefab_key",
        "class",
        "max_hp",
        "attack",
        "attack_range",
        "move_range",
        "vision_range",
        "train_cost",
        "upkeep",
        "multipliers",
        "flags",
        "ui"
      ],
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "icon_key": { "type": "string", "minLength": 1 },
        "prefab_key": { "type": "string", "minLength": 1 },
        "class": { "type": "string", "minLength": 1 },
        "max_hp": { "type": "integer", "minimum": 1 },
        "attack": { "type": "integer", "minimum": 0 },
        "attack_range": { "type": "integer", "minimum": 0 },
        "move_range": { "type": "integer", "minimum": 0 },
        "vision_range": { "type": "integer", "minimum": 0 },
        "train_cost": { "$ref": "#/$defs/resourceMap" },
        "upkeep": { "$ref": "#/$defs/resourceMap" },
        "multipliers": { "$ref": "#/$defs/multiplierMap" },
        "flags": { "$ref": "#/$defs/flags" },
        "road_speed_bonus": { "type": "integer", "minimum": 0 },
        "charge_bonus": { "type": "number", "minimum": 0 },
        "ui": { "$ref": "#/$defs/ui" },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
