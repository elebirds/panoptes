{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://panoptes.local/schemas/buildconfig.schema.json",
  "title": "Panoptes Build Config",
  "type": "object",
  "required": ["config_version", "default_locale", "buildings"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "config_version": { "type": "string", "minLength": 1 },
    "default_locale": { "type": "string", "minLength": 1 },
    "buildings": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/building" }
    }
  },
  "$defs": {
    "resourceMap": {
      "type": "object",
      "additionalProperties": {
        "type": "integer"
      }
    },
    "production": {
      "type": "object",
      "required": ["input", "output", "cycle_turns"],
      "additionalProperties": false,
      "properties": {
        "input": { "$ref": "#/$defs/resourceMap" },
        "output": { "$ref": "#/$defs/resourceMap" },
        "cycle_turns": { "type": "integer", "minimum": 0 }
      }
    },
    "combat": {
      "type": "object",
      "required": ["max_hp"],
      "additionalProperties": true,
      "properties": {
        "max_hp": { "type": "integer", "minimum": 1 },
        "attack_per_turn": { "type": "integer", "minimum": 0 },
        "range": { "type": "integer", "minimum": 0 },
        "defense_bonus_per_level": { "type": "number", "minimum": 0 },
        "max_level": { "type": "integer", "minimum": 1 },
        "vision_range_bonus": { "type": "integer", "minimum": 0 }
      }
    },
    "limits": {
      "type": "object",
      "required": ["max_per_node", "max_per_player"],
      "additionalProperties": false,
      "properties": {
        "max_per_node": { "type": "integer", "minimum": 1 },
        "max_per_player": { "type": "integer" }
      }
    },
    "ui": {
      "type": "object",
      "required": ["sort_order"],
      "additionalProperties": false,
      "properties": {
        "sort_order": { "type": "integer", "minimum": 0 }
      }
    },
    "building": {
      "type": "object",
      "required": [
        "id",
        "name",
        "description",
        "icon_key",
        "prefab_key",
        "category",
        "placement_rule",
        "build_cost",
        "upkeep",
        "production",
        "combat",
        "limits",
        "ui"
      ],
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "icon_key": { "type": "string", "minLength": 1 },
        "prefab_key": { "type": "string", "minLength": 1 },
        "category": {
          "type": "string",
          "enum": ["production", "military_production", "military", "utility"]
        },
        "placement_rule": {
          "type": "string",
          "enum": ["any_terrain", "resource_only", "city_only"]
        },
        "required_resource_type": {
          "type": "string"
        },
        "build_cost": { "$ref": "#/$defs/resourceMap" },
        "upkeep": { "$ref": "#/$defs/resourceMap" },
        "production": { "$ref": "#/$defs/production" },
        "produces_units": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
        },
        "combat": { "$ref": "#/$defs/combat" },
        "limits": { "$ref": "#/$defs/limits" },
        "ui": { "$ref": "#/$defs/ui" },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
