{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://panoptes.local/schemas/maptileconfig.schema.json",
  "title": "Panoptes Map Tile Config",
  "type": "object",
  "required": ["config_version", "default_tile_size", "terrain_tiles", "overlay_markers"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "config_version": { "type": "string", "minLength": 1 },
    "default_tile_size": { "type": "number", "exclusiveMinimum": 0 },
    "terrain_tiles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/terrainTile" }
    },
    "overlay_markers": {
      "type": "array",
      "items": { "$ref": "#/$defs/overlayMarker" }
    }
  },
  "$defs": {
    "terrainTile": {
      "type": "object",
      "required": [
        "id",
        "name",
        "icon_key",
        "material_key",
        "move_cost_no_road",
        "passable",
        "buildable"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "name": { "type": "string", "minLength": 1 },
        "icon_key": { "type": "string", "minLength": 1 },
        "material_key": { "type": "string", "minLength": 1 },
        "move_cost_no_road": { "type": "integer", "minimum": 0 },
        "passable": { "type": "boolean" },
        "buildable": { "type": "boolean" }
      }
    },
    "overlayMarker": {
      "type": "object",
      "required": ["id", "name", "icon_key", "source_field"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "name": { "type": "string", "minLength": 1 },
        "icon_key": { "type": "string", "minLength": 1 },
        "source_field": { "type": "string", "minLength": 1 }
      }
    }
  }
}
