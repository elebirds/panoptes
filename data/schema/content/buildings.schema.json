{
  "$defs": {
    "point_amount": {
      "additionalProperties": false,
      "properties": {
        "industry_output": {
          "minimum": 0,
          "type": "integer"
        },
        "research_output": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "resource_amount": {
      "additionalProperties": false,
      "properties": {
        "food": {
          "minimum": 0,
          "type": "integer"
        },
        "ore": {
          "minimum": 0,
          "type": "integer"
        },
        "wood": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    }
  },
  "$id": "content/buildings.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "buildings": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "building_scope": {
            "enum": [
              "out_of_city",
              "in_city",
              "city_core"
            ],
            "type": "string"
          },
          "default_recipe_id": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "max_hp": {
            "minimum": 0,
            "type": "integer"
          },
          "placement_kind": {
            "enum": [
              "resource_node",
              "city_territory",
              "city_foundation_center"
            ],
            "type": "string"
          },
          "point_costs": {
            "$ref": "#/$defs/point_amount"
          },
          "recipe_ids": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "required_resource_type": {
            "enum": [
              "food",
              "ore",
              "wood",
              ""
            ],
            "type": "string"
          },
          "resource_costs": {
            "$ref": "#/$defs/resource_amount"
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "takeover_mode": {
            "enum": [
              "disabled",
              "delayed",
              "city_capture"
            ],
            "type": "string"
          }
        },
        "required": [
          "id",
          "placement_kind",
          "building_scope",
          "required_resource_type",
          "resource_costs",
          "point_costs",
          "recipe_ids",
          "default_recipe_id",
          "max_hp",
          "takeover_mode"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "buildings"
  ],
  "type": "object"
}
