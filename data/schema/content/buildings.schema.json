{
  "$defs": {
    "modifier_effect": {
      "additionalProperties": false,
      "properties": {
        "modifier_type": {
          "enum": [
            "flat",
            "percent",
            "multiplier"
          ],
          "type": "string"
        },
        "point_key": {
          "enum": [
            "industry_output",
            "research_output",
            ""
          ],
          "type": "string"
        },
        "resource_key": {
          "enum": [
            "food",
            "ore",
            "wood",
            ""
          ],
          "type": "string"
        },
        "target_id": {
          "type": "string"
        },
        "trigger": {
          "enum": [
            "building.resource_cost",
            "building.point_cost",
            "building.max_hp",
            "recipe.resource_input",
            "recipe.point_input",
            "recipe.resource_output",
            "recipe.work_amount",
            "recipe.base_progress",
            "unit.attack",
            "unit.move_range",
            "unit.siege_multiplier",
            "logistics.road_capacity",
            "point.output"
          ],
          "type": "string"
        },
        "value": {
          "type": "number"
        }
      },
      "required": [
        "trigger",
        "modifier_type",
        "value"
      ],
      "type": "object"
    },
    "point_amount": {
      "additionalProperties": false,
      "properties": {
        "industry_output": {
          "minimum": 0,
          "type": "integer"
        },
        "research_output": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "resource_amount": {
      "additionalProperties": false,
      "properties": {
        "food": {
          "minimum": 0,
          "type": "integer"
        },
        "ore": {
          "minimum": 0,
          "type": "integer"
        },
        "wood": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "technology_effect": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "target_id": {
              "type": "string"
            },
            "type": {
              "enum": [
                "unlock_building"
              ],
              "type": "string"
            }
          },
          "required": [
            "type",
            "target_id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "target_id": {
              "type": "string"
            },
            "type": {
              "enum": [
                "unlock_recipe"
              ],
              "type": "string"
            }
          },
          "required": [
            "type",
            "target_id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "target_id": {
              "type": "string"
            },
            "type": {
              "enum": [
                "unlock_policy"
              ],
              "type": "string"
            }
          },
          "required": [
            "type",
            "target_id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "institution_slots": {
              "minimum": 1,
              "type": "integer"
            },
            "type": {
              "enum": [
                "add_institution_slots"
              ],
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "grant_resources": {
              "$ref": "#/$defs/resource_amount"
            },
            "grant_units": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "type": {
              "enum": [
                "grant"
              ],
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        }
      ]
    }
  },
  "$id": "content/buildings.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "buildings": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "building_scope": {
            "enum": [
              "out_of_city",
              "in_city",
              "city_core"
            ],
            "type": "string"
          },
          "default_recipe_id": {
            "type": "string"
          },
          "explicit_effects": {
            "items": {
              "$ref": "#/$defs/technology_effect"
            },
            "type": "array"
          },
          "id": {
            "type": "string"
          },
          "max_hp": {
            "minimum": 0,
            "type": "integer"
          },
          "modifier_effects": {
            "items": {
              "$ref": "#/$defs/modifier_effect"
            },
            "type": "array"
          },
          "placement_kind": {
            "enum": [
              "resource_node",
              "city_territory",
              "city_foundation_center"
            ],
            "type": "string"
          },
          "point_costs": {
            "$ref": "#/$defs/point_amount"
          },
          "recipe_ids": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "required_resource_type": {
            "enum": [
              "food",
              "ore",
              "wood",
              ""
            ],
            "type": "string"
          },
          "resource_costs": {
            "$ref": "#/$defs/resource_amount"
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "takeover_mode": {
            "enum": [
              "disabled",
              "delayed",
              "city_capture"
            ],
            "type": "string"
          }
        },
        "required": [
          "id",
          "placement_kind",
          "building_scope",
          "required_resource_type",
          "resource_costs",
          "point_costs",
          "recipe_ids",
          "default_recipe_id",
          "max_hp",
          "takeover_mode"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "buildings"
  ],
  "type": "object"
}
