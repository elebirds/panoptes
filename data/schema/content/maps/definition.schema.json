{
  "$defs": {
    "grid_point": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "minimum": 0,
          "type": "integer"
        },
        "y": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "type": "object"
    },
    "map_generator": {
      "additionalProperties": false,
      "properties": {
        "seed": {
          "type": "integer"
        },
        "terrain_bands": {
          "items": {
            "$ref": "#/$defs/terrain_band"
          },
          "type": "array"
        },
        "type": {
          "enum": [
            "noise"
          ],
          "type": "string"
        }
      },
      "required": [
        "type",
        "seed"
      ],
      "type": "object"
    },
    "modifier_effect": {
      "additionalProperties": false,
      "properties": {
        "modifier_type": {
          "enum": [
            "flat",
            "percent",
            "multiplier"
          ],
          "type": "string"
        },
        "point_key": {
          "enum": [
            "industry_output",
            "research_output",
            ""
          ],
          "type": "string"
        },
        "resource_key": {
          "enum": [
            "food",
            "ore",
            "wood",
            ""
          ],
          "type": "string"
        },
        "target_id": {
          "type": "string"
        },
        "trigger": {
          "enum": [
            "building.resource_cost",
            "building.point_cost",
            "building.max_hp",
            "recipe.resource_input",
            "recipe.point_input",
            "recipe.resource_output",
            "recipe.work_amount",
            "recipe.base_progress",
            "unit.attack",
            "unit.move_range",
            "unit.siege_multiplier",
            "point.output"
          ],
          "type": "string"
        },
        "value": {
          "type": "number"
        }
      },
      "required": [
        "trigger",
        "modifier_type",
        "value"
      ],
      "type": "object"
    },
    "point_amount": {
      "additionalProperties": false,
      "properties": {
        "industry_output": {
          "minimum": 0,
          "type": "integer"
        },
        "research_output": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "prerequisite": {
      "additionalProperties": false,
      "properties": {
        "target_id": {
          "type": "string"
        },
        "type": {
          "enum": [
            "technology_unlocked",
            "policy_active"
          ],
          "type": "string"
        }
      },
      "required": [
        "type",
        "target_id"
      ],
      "type": "object"
    },
    "resource_amount": {
      "additionalProperties": false,
      "properties": {
        "food": {
          "minimum": 0,
          "type": "integer"
        },
        "ore": {
          "minimum": 0,
          "type": "integer"
        },
        "wood": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "spawn_point": {
      "additionalProperties": false,
      "properties": {
        "slot": {
          "minimum": 0,
          "type": "integer"
        },
        "x": {
          "minimum": 0,
          "type": "integer"
        },
        "y": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "slot",
        "x",
        "y"
      ],
      "type": "object"
    },
    "technology_effect": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "target_id": {
              "type": "string"
            },
            "type": {
              "enum": [
                "unlock_building"
              ],
              "type": "string"
            }
          },
          "required": [
            "type",
            "target_id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "target_id": {
              "type": "string"
            },
            "type": {
              "enum": [
                "unlock_recipe"
              ],
              "type": "string"
            }
          },
          "required": [
            "type",
            "target_id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "grant_resources": {
              "$ref": "#/$defs/resource_amount"
            },
            "grant_units": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "type": {
              "enum": [
                "grant"
              ],
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        }
      ]
    },
    "terrain_band": {
      "additionalProperties": false,
      "properties": {
        "max": {
          "minimum": 0,
          "type": "number"
        },
        "terrain": {
          "enum": [
            "forest",
            "plain",
            "river"
          ],
          "type": "string"
        }
      },
      "required": [
        "max",
        "terrain"
      ],
      "type": "object"
    }
  },
  "$id": "content/maps/definition.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "features": {
      "additionalProperties": false,
      "properties": {
        "central_points": {
          "items": {
            "$ref": "#/$defs/grid_point"
          },
          "type": "array"
        },
        "named_nodes": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "x": {
                "minimum": 0,
                "type": "integer"
              },
              "y": {
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "x",
              "y",
              "name"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "resource_points": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "node_name": {
                "type": "string"
              },
              "resource_type": {
                "enum": [
                  "food",
                  "ore",
                  "wood"
                ],
                "type": "string"
              },
              "x": {
                "minimum": 0,
                "type": "integer"
              },
              "y": {
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "x",
              "y",
              "resource_type"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "roads": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "points": {
                "items": {
                  "$ref": "#/$defs/grid_point"
                },
                "minItems": 1,
                "type": "array"
              }
            },
            "required": [
              "points"
            ],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [
        "resource_points",
        "roads",
        "named_nodes",
        "central_points"
      ],
      "type": "object"
    },
    "generator": {
      "$ref": "#/$defs/map_generator"
    },
    "meta": {
      "additionalProperties": false,
      "properties": {
        "default_terrain": {
          "enum": [
            "forest",
            "plain",
            "river"
          ],
          "type": "string"
        },
        "height": {
          "minimum": 1,
          "type": "integer"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "width": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "name",
        "width",
        "height",
        "default_terrain"
      ],
      "type": "object"
    },
    "node_overrides": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "building_hp": {
            "minimum": 0,
            "type": "integer"
          },
          "building_type": {
            "enum": [
              "barracks",
              "city_core",
              "farm",
              "lumber",
              "mine",
              "wall",
              ""
            ],
            "type": "string"
          },
          "has_road": {
            "type": "boolean"
          },
          "id": {
            "type": "string"
          },
          "is_resource_point": {
            "type": "boolean"
          },
          "node_name": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "owner_slot": {
            "minimum": 0,
            "type": "integer"
          },
          "resource_type": {
            "enum": [
              "food",
              "ore",
              "wood",
              ""
            ],
            "type": "string"
          },
          "terrain": {
            "enum": [
              "forest",
              "plain",
              "river",
              ""
            ],
            "type": "string"
          },
          "territory_owner": {
            "type": "string"
          },
          "territory_owner_slot": {
            "minimum": 0,
            "type": "integer"
          },
          "x": {
            "minimum": 0,
            "type": "integer"
          },
          "y": {
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "x",
          "y"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "spawn_points": {
      "items": {
        "$ref": "#/$defs/spawn_point"
      },
      "minItems": 1,
      "type": "array"
    },
    "terrain_patches": {
      "items": {
        "oneOf": [
          {
            "additionalProperties": false,
            "properties": {
              "kind": {
                "enum": [
                  "point"
                ],
                "type": "string"
              },
              "points": {
                "items": {
                  "$ref": "#/$defs/grid_point"
                },
                "minItems": 1,
                "type": "array"
              },
              "terrain": {
                "enum": [
                  "forest",
                  "plain",
                  "river"
                ],
                "type": "string"
              }
            },
            "required": [
              "kind",
              "terrain",
              "points"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "height": {
                "minimum": 1,
                "type": "integer"
              },
              "kind": {
                "enum": [
                  "rect"
                ],
                "type": "string"
              },
              "terrain": {
                "enum": [
                  "forest",
                  "plain",
                  "river"
                ],
                "type": "string"
              },
              "width": {
                "minimum": 1,
                "type": "integer"
              },
              "x": {
                "minimum": 0,
                "type": "integer"
              },
              "y": {
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "kind",
              "terrain",
              "x",
              "y",
              "width",
              "height"
            ],
            "type": "object"
          }
        ]
      },
      "type": "array"
    }
  },
  "required": [
    "meta",
    "terrain_patches",
    "node_overrides",
    "features",
    "spawn_points"
  ],
  "type": "object"
}
