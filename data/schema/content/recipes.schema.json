{
  "$defs": {
    "point_amount": {
      "additionalProperties": false,
      "properties": {
        "industry_output": {
          "minimum": 0,
          "type": "integer"
        },
        "research_output": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "resource_amount": {
      "additionalProperties": false,
      "properties": {
        "food": {
          "minimum": 0,
          "type": "integer"
        },
        "ore": {
          "minimum": 0,
          "type": "integer"
        },
        "wood": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    }
  },
  "$id": "content/recipes.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "recipes": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "base_progress": {
            "minimum": 1,
            "type": "integer"
          },
          "building_id": {
            "enum": [
              "archery",
              "barracks",
              "city_core",
              "engineer_camp",
              "farm",
              "frontier_office",
              "granary",
              "lumber",
              "mine",
              "smelter",
              "stable",
              "wall",
              "workshop"
            ],
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "outputs": {
            "additionalProperties": false,
            "properties": {
              "point_progress": {
                "$ref": "#/$defs/point_amount"
              },
              "resources": {
                "$ref": "#/$defs/resource_amount"
              },
              "state_changes": {
                "additionalProperties": {
                  "type": "integer"
                },
                "type": "object"
              },
              "units": {
                "items": {
                  "enum": [
                    "archer",
                    "cavalry",
                    "infantry",
                    "raider",
                    "settler",
                    "siege_engine"
                  ],
                  "type": "string"
                },
                "type": "array"
              }
            },
            "type": "object"
          },
          "point_inputs": {
            "$ref": "#/$defs/point_amount"
          },
          "resource_inputs": {
            "$ref": "#/$defs/resource_amount"
          },
          "work_amount": {
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "id",
          "building_id",
          "resource_inputs",
          "point_inputs",
          "work_amount",
          "base_progress",
          "outputs"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "recipes"
  ],
  "type": "object"
}
