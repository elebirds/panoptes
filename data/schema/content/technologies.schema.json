{
  "$defs": {
    "modifier_effect": {
      "additionalProperties": false,
      "properties": {
        "modifier_type": {
          "enum": [
            "flat",
            "percent",
            "multiplier"
          ],
          "type": "string"
        },
        "point_key": {
          "enum": [
            "industry_output",
            "research_output",
            ""
          ],
          "type": "string"
        },
        "resource_key": {
          "enum": [
            "food",
            "ore",
            "wood",
            ""
          ],
          "type": "string"
        },
        "target_id": {
          "type": "string"
        },
        "trigger": {
          "enum": [
            "building.resource_cost",
            "building.point_cost",
            "building.max_hp",
            "recipe.resource_input",
            "recipe.point_input",
            "recipe.resource_output",
            "recipe.work_amount",
            "recipe.base_progress",
            "unit.attack",
            "unit.move_range",
            "unit.siege_multiplier",
            "point.output"
          ],
          "type": "string"
        },
        "value": {
          "type": "number"
        }
      },
      "required": [
        "trigger",
        "modifier_type",
        "value"
      ],
      "type": "object"
    },
    "prerequisite": {
      "additionalProperties": false,
      "properties": {
        "target_id": {
          "type": "string"
        },
        "type": {
          "enum": [
            "technology_unlocked",
            "policy_active"
          ],
          "type": "string"
        }
      },
      "required": [
        "type",
        "target_id"
      ],
      "type": "object"
    },
    "resource_amount": {
      "additionalProperties": false,
      "properties": {
        "food": {
          "minimum": 0,
          "type": "integer"
        },
        "ore": {
          "minimum": 0,
          "type": "integer"
        },
        "wood": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "technology_effect": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "target_id": {
              "type": "string"
            },
            "type": {
              "enum": [
                "unlock_building"
              ],
              "type": "string"
            }
          },
          "required": [
            "type",
            "target_id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "target_id": {
              "type": "string"
            },
            "type": {
              "enum": [
                "unlock_recipe"
              ],
              "type": "string"
            }
          },
          "required": [
            "type",
            "target_id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "target_id": {
              "type": "string"
            },
            "type": {
              "enum": [
                "unlock_policy"
              ],
              "type": "string"
            }
          },
          "required": [
            "type",
            "target_id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "institution_slots": {
              "minimum": 1,
              "type": "integer"
            },
            "type": {
              "enum": [
                "add_institution_slots"
              ],
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "grant_resources": {
              "$ref": "#/$defs/resource_amount"
            },
            "grant_units": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "type": {
              "enum": [
                "grant"
              ],
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        }
      ]
    }
  },
  "$id": "content/technologies.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "technologies": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "branch": {
            "type": "string"
          },
          "explicit_effects": {
            "items": {
              "$ref": "#/$defs/technology_effect"
            },
            "type": "array"
          },
          "id": {
            "type": "string"
          },
          "modifier_effects": {
            "items": {
              "$ref": "#/$defs/modifier_effect"
            },
            "type": "array"
          },
          "prerequisites": {
            "items": {
              "$ref": "#/$defs/prerequisite"
            },
            "type": "array"
          },
          "research_cost": {
            "minimum": 0,
            "type": "integer"
          },
          "tier": {
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "id",
          "branch",
          "tier",
          "research_cost",
          "prerequisites",
          "explicit_effects",
          "modifier_effects"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "technologies"
  ],
  "type": "object"
}
