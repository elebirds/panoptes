  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "bundle_hash": {
      "type": "string"
    },
    "content_version": {
      "type": "string"
    },
    "default_locale": {
      "type": "string"
    },
    "default_map_id": {
