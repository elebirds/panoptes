PORT=8080

# 日志配置
# LOG_LEVEL: 日志级别 (debug, info, warn, error)
#   - debug: 显示所有日志，包括调试信息
#   - info:  显示一般信息日志（默认）
#   - warn:  仅显示警告和错误
#   - error: 仅显示错误
LOG_LEVEL=info

# LOG_FORMAT: 日志格式 (auto, console, json, text)
#   - auto:    自动检测终端，终端使用 console，非终端使用 json（默认）
#   - console: 强制使用彩色控制台格式
#   - json:    JSON 结构化格式，适合日志聚合系统
#   - text:    纯文本格式，适合 CI/CD 环境
LOG_FORMAT=auto

# PostgreSQL 配置
# 连接字符串格式: postgres://用户名:密码@主机:端口/数据库名?参数
POSTGRES_DSN=postgres://panoptes:panoptes_dev@localhost:5432/panoptes?sslmode=disable

# Redis 配置
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# LLM 配置
QWEN_API_KEY=
DEEPSEEK_API_KEY=

# Gameplay map selection
MAP_ID=default
USE_PROCEDURAL_MAP=false

# Local development
DEV_MODE=true
